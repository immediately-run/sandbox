{
  "name": "@immediately-run/sandbox",
  "version": "2.0.0",
  "description": "The immediately.run in-iframe bundler \u2014 a fork of CodeSandbox's sandpack-bundler (Apache-2.0, see LICENSE), diverged substantially for the immediately.run sandbox.",
  "engines": {
    "node": "24"
  },
  "license": "Apache-2.0",
  "author": "immediately.run",
  "keywords": [],
  "repository": {
    "type": "git",
    "url": "https://github.com/immediately-run/sandbox"
  },
  "scripts": {
    "clean": "rm -rf dist/* .parcel-cache",
    "prepare": "git config core.hooksPath .githooks || true",
    "check:freshness": "node scripts/check-freshness.mjs",
    "predev": "node scripts/check-freshness.mjs",
    "dev": "parcel ./src/index.html ./src/m3.html",
    "start": "node ./server.js",
    "gen:toolchain-hash": "node scripts/gen-toolchain-hash.mjs",
    "build": "npm run clean && npm run gen:toolchain-hash && npm run build:authoring-worker && npm run sync:authoring-worker && npm run build:parcel && npm run check:parity && npm run check:dist-documents && node scripts/build-stamp.mjs",
    "check:parity": "node scripts/check-importmap-parity.mjs",
    "build:parcel": "parcel build --target default --no-scope-hoist",
    "gen:authoring-bundles": "node scripts/gen-authoring-libs.mjs && node scripts/gen-authoring-types.mjs",
    "build:authoring-worker": "npm run gen:authoring-bundles && parcel build --target authoringWorker --no-scope-hoist --cache-dir .parcel-cache-authoring-worker",
    "sync:authoring-worker": "./scripts/sync-authoring-worker.sh",
    "check:sidecar": "node scripts/check-sidecar-literal.mjs",
    "pretest": "npm run check:sidecar && npm run gen:authoring-bundles",
    "test": "jest",
    "pretypecheck": "npm run gen:authoring-bundles",
    "typecheck": "tsc --noEmit",
    "protocol:check": "node scripts/check-protocol-snapshot.mjs",
    "protocol:selftest": "node scripts/check-protocol-snapshot.mjs --self-test",
    "protocol:compat": "node scripts/check-sdk-compat.mjs",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json}\" \"scripts/**/*.mjs\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json}\" \"scripts/**/*.mjs\"",
    "lint": "eslint '**/*.ts?(x)'",
    "verify": "npm run lint && npm run format:check && npm run typecheck && npm run protocol:check && npm run protocol:selftest && npm run check:dist-documents:selftest && npm test -- --forceExit && npm run build",
    "drill:m3-csp": "node scripts/m3-csp-drill.mjs",
    "deploy": "firebase deploy",
    "drill:test-realm": "node scripts/test-realm-drill.mjs",
    "check:dist-documents": "node scripts/check-dist-documents.mjs",
    "check:dist-documents:selftest": "node scripts/check-dist-documents.mjs --self-test"
  },
  "browserslist": "> 2.5%, not ie 11, not dead, not op_mini all",
  "alias": {
    "globby": "./src/services/authoring/empty-module.js"
  },
  "targets": {
    "default": {
      "source": [
        "src/index.html",
        "src/m3.html",
        "src/test-realm.html"
      ],
      "distDir": "dist",
      "context": "browser",
      "includeNodeModules": true
    },
    "authoringWorker": {
      "source": "src/services/authoring/authoring-worker.ts",
      "distDir": "dist-authoring-worker",
      "context": "web-worker",
      "outputFormat": "global",
      "isLibrary": false,
      "optimize": true,
      "sourceMap": false,
      "includeNodeModules": true
    }
  },
  "dependencies": {
    "@babel/plugin-proposal-explicit-resource-management": "7.25.9",
    "@babel/standalone": "7.27.0",
    "@immediately-run/platform-constants": "0.2.0",
    "@immediately-run/sandbox-protocol": "0.3.1",
    "@immediately-run/transpiler": "^0.8.0",
    "@msgpack/msgpack": "^2.8.0",
    "@swc/helpers": "0.5.17",
    "@types/babel__standalone": "7.1.9",
    "@zenfs/core": "^2.5.6",
    "babel-preset-solid": "^1.3.13",
    "console-feed": "3.8.0",
    "gensync": "^1.0.0-beta.2",
    "kerium": "^1.3.9",
    "micromatch": "^4.0.5",
    "p-queue": "^6.6.2",
    "postcss": "^8.4.14",
    "postcss-url": "^10.1.3",
    "postcss-value-parser": "^4.2.0",
    "react": "19.1.0",
    "react-refresh": "0.17.0",
    "settle-promise": "^1.0.0",
    "solid-refresh": "^0.4.0",
    "source-map": "^0.6.1",
    "strip-json-comments": "^4.0.0",
    "url-join": "^5.0.0"
  },
  "devDependencies": {
    "@immediately-run/prettier-config": "0.1.0",
    "@immediately-run/sdk": "^0.46.0",
    "@octokit/rest": "^18.12.0",
    "@swc-node/jest": "^1.4.3",
    "@types/jest": "^27.4.1",
    "@types/micromatch": "^4.0.2",
    "@types/postcss-url": "^10.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/url-join": "^4.0.1",
    "@types/uuid": "^8.3.4",
    "@typescript-eslint/eslint-plugin": "^5.28.0",
    "@typescript-eslint/parser": "^5.28.0",
    "assert": "^2.0.0",
    "buffer": "^6.0.3",
    "crypto-browserify": "^3.12.0",
    "eslint": "^7.32.0 || ^8.2.0",
    "eslint-linter-browserify": "^8.52.0",
    "events": "^3.3.0",
    "fastify": "^3.28.0",
    "fastify-static": "^4.6.1",
    "firebase-tools": "^14.4.0",
    "gzip-size": "^7.0.0",
    "jest": "^27.5.1",
    "jest-extended": "^2.0.0",
    "node-fetch": "^3.2.4",
    "os-browserify": "^0.3.0",
    "parcel": "2.14.4",
    "parcel-reporter-static-files-copy": "^1.5.3",
    "path-browserify": "^1.0.1",
    "prettier": "2.8.8",
    "process": "^0.11.10",
    "punycode": "^2.3.1",
    "stream-browserify": "^3.0.0",
    "typescript": "5.8.3",
    "url": "^0.11.0",
    "util": "^0.12.4"
  },
  "resolutions": {
    "@babel/preset-env": "7.27.0",
    "@swc/core": "1.11.24",
    "react": "19.1.0"
  },
  "overrides": {
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "typescript": "5.8.3"
  },
  "@parcel/resolver-default": {
    "packageExports": true
  },
  "private": true,
  "contributors": [
    "CodeSandbox BV (original sandpack-bundler author)"
  ],
  "prettier": "@immediately-run/prettier-config"
}
